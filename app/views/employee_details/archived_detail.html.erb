<div class="main-content sidebar-hidden bg-gray-50 min-h-screen">
  <div class="min-h-screen pl-64 pr-4 pt-4 pb-12 overflow-x-auto bg-gradient-to-br from-slate-50 via-white to-teal-50/40">
    <div class="w-full max-w-7xl mx-auto px-4 py-8">
      <div class="bg-white rounded-2xl shadow-lg border border-gray-200 mb-8 px-8 py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-xl bg-teal-100 flex items-center justify-center shrink-0"><i class="fas fa-chart-pie text-2xl text-teal-700"></i></div>
          <div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-900"><%= @employee_detail.employee_name %> - <%= @quarter %> KRA History</h1>
            <p class="text-gray-600 mt-1 text-sm md:text-base font-medium"><%= @employee_detail.employee_code %> | <%= @financial_year %> | <%= @quarter_label %></p>
          </div>
        </div>
        <%= link_to archived_employee_details_path(financial_year: @financial_year, quarter: @quarter), class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold border border-gray-300" do %><i class="fas fa-arrow-left"></i> Back to List<% end %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <% @detail_payload[:months].each do |month| %>
          <%= link_to employee_detail_path(@employee_detail, financial_year: @financial_year, quarter: @quarter, month: month[:key], source: "archived"), class: "history-month-card" do %>
            <div class="history-month-header"><span class="size-2 rounded-full bg-white/80"></span><%= month[:label] %><span class="ml-auto text-xs font-medium opacity-90">View data →</span></div>
            <div class="history-month-body">
              <div class="history-percent"><div class="text-xs font-semibold tracking-wider text-emerald-600">Achievement %</div><div class="mt-1 text-4xl font-extrabold text-emerald-700"><%= month[:achievement_percentage] %>%</div></div>

              <div class="history-remark border-l-blue-500"><div class="history-remark-label text-blue-600">L1 Remarks</div><div class="history-remark-text"><%= Array(month[:l1_remarks]).presence&.join(", ") || "-" %></div></div>

              <% observer_levels_for_display(@employee_detail).each do |level| %>
                <% remarks = Array(month["#{level}_remarks".to_sym]).reject(&:blank?) %>
                <% if remarks.any? %><div class="history-remark border-l-sky-500"><div class="history-remark-label text-sky-700"><%= observer_column_label(level) %> Remarks</div><div class="history-remark-text"><%= remarks.join(", ") %></div></div><% end %>
              <% end %>

              <% if l2_reviewer_assigned?(@employee_detail) && month[:l2_remarks].present? %><div class="history-remark border-l-violet-500"><div class="history-remark-label text-violet-700">L2 Remarks</div><div class="history-remark-text"><%= Array(month[:l2_remarks]).join(", ") %></div></div><% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="text-center mb-6">
        <div class="inline-block bg-white rounded-2xl shadow-md border border-emerald-200 px-10 py-5">
          <p class="text-xs font-bold tracking-widest text-gray-500">Quarter total achievement %</p>
          <p class="mt-1 text-4xl font-extrabold text-emerald-700"><%= @detail_payload[:quarter_percentage] %>%</p>
          <p class="text-xs text-gray-500 mt-2">Average of <%= @detail_payload[:quarter_month_count] %> submitted month(s) (<%= @detail_payload[:months].map { |month| month[:label] }.join(', ') %>)</p>
        </div>
      </div>

      <% if @review.present? %>
        <div class="history-final-card">
          <div class="history-final-icon"><i class="fas fa-check"></i></div>
          <div><p class="text-2xl font-extrabold text-green-900">Final PLI Saved</p><div class="mt-3 flex flex-wrap gap-3"><span class="history-final-pill">Final %: <strong><%= @review.final_percentage.present? ? format('%.2f%%', @review.final_percentage.to_f) : '-' %></strong></span><% if @review.final_remarks.present? %><span class="history-final-pill">Remarks: <strong><%= @review.final_remarks %></strong></span><% end %></div></div>
        </div>
      <% else %>
        <div class="mx-auto max-w-xl rounded-xl border border-amber-200 bg-amber-50 px-5 py-4 text-center text-sm font-semibold text-amber-700">Quarterly PLI approval pending</div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .min-h-screen{padding-left:16rem}.sidebar-hidden .min-h-screen{padding-left:1rem!important;padding-right:1rem!important}.sidebar-hidden .max-w-7xl{max-width:100%!important;width:100%!important}
  .history-month-card{display:block;border-radius:1rem;overflow:hidden;background:#fff;box-shadow:0 4px 24px rgba(0,0,0,.06);transition:.2s}.history-month-card:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(0,0,0,.1)}
  .history-month-header{display:flex;align-items:center;gap:.55rem;padding:1rem 1.25rem;background:linear-gradient(135deg,#0f766e,#14b8a6);color:#fff;font-size:1.1rem;font-weight:700;letter-spacing:.04em}
  .history-month-body{display:flex;flex-direction:column;gap:1rem;padding:1.4rem}.history-percent{text-align:center;padding:1.2rem;border:1px solid #a7f3d0;border-radius:.75rem;background:linear-gradient(135deg,#ecfdf5,#d1fae5)}
  .history-remark{border:1px solid #e2e8f0;border-left-width:4px;border-radius:.75rem;background:#f8fafc;padding:1rem}.history-remark-label{font-size:.7rem;font-weight:700;letter-spacing:.05em;margin-bottom:.5rem}.history-remark-text{min-height:1.5rem;color:#1f2937;font-size:.875rem;line-height:1.5}
  .history-final-card{display:flex;align-items:center;justify-content:center;gap:1.25rem;width:min(100%,40rem);margin:1.5rem auto 0;padding:2rem;border:1px solid #86efac;border-radius:1.25rem;background:linear-gradient(135deg,#f0fdf4,#dcfce7);box-shadow:0 18px 40px rgba(22,163,74,.16)}.history-final-icon{display:flex;align-items:center;justify-content:center;width:3.6rem;height:3.6rem;border-radius:1rem;background:#16a34a;color:#fff;font-size:1.5rem}.history-final-pill{display:inline-flex;padding:.55rem .8rem;border:1px solid #bbf7d0;border-radius:.75rem;background:rgba(255,255,255,.75);color:#166534;font-size:.9rem}
</style>
