<div class="main-content bg-gradient-to-br from-slate-50 via-white to-teal-50 min-h-screen">
  <div class="p-4 lg:p-8">
    <div class="bg-white rounded-2xl shadow-lg border mb-8 px-8 py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-xl bg-teal-100 flex items-center justify-center"><i class="fas fa-chart-pie text-2xl text-teal-700"></i></div>
        <div><h1 class="text-2xl md:text-3xl font-bold"><%= @employee_detail.employee_name %> - <%= @quarter %> Archived KRA</h1><p class="text-gray-600 mt-1 font-medium"><%= @employee_detail.employee_code %> | <%= @financial_year %> | <%= @quarter_label %></p></div>
      </div>
      <%= link_to "Back to Archived", archived_employee_details_path(financial_year: @financial_year, quarter: @quarter), class: "px-5 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 font-semibold border" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <% @detail_payload[:months].each do |month| %>
        <% month_key = month[:key] %>
        <%= link_to employee_detail_path(@employee_detail, financial_year: @financial_year, quarter: @quarter, month: month_key), class: "archive-month-card block" do %>
          <div class="archive-month-header"><span>•</span> <%= month[:label] %><span class="ml-auto text-xs font-medium">View filled data →</span></div>
          <div class="p-5 space-y-3">
            <div class="text-center p-4 bg-emerald-50 border border-emerald-200 rounded-xl"><div class="text-xs font-semibold text-emerald-600">Achievement %</div><div class="text-3xl font-extrabold text-emerald-700"><%= month[:achievement_percentage] %>%</div></div>
            <div class="archive-remark"><strong>L1 Remarks</strong><div><%= Array(month[:l1_remarks]).presence&.join(", ") || "-" %></div></div>
            <% observer_levels_for_display(@employee_detail).each do |level| %>
              <% remarks = Array(month["#{level}_remarks".to_sym]).reject(&:blank?) %>
              <% if remarks.any? %><div class="archive-remark"><strong><%= observer_column_label(level) %> Remarks</strong><div><%= remarks.join(", ") %></div></div><% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="text-center mb-8"><div class="inline-block bg-white rounded-2xl shadow-md border border-emerald-200 px-10 py-5"><p class="text-xs font-bold tracking-widest text-gray-500">QUARTER TOTAL ACHIEVEMENT %</p><p class="text-4xl font-extrabold text-emerald-700"><%= @detail_payload[:quarter_percentage] %>%</p><p class="text-xs text-gray-500 mt-2">Average of <%= @detail_payload[:quarter_month_count] %> submitted months</p></div></div>

    <% if @review.present? %><div class="mt-8 mx-auto max-w-2xl p-6 rounded-2xl border <%= @review.status == 'approved' ? 'bg-green-50 border-green-300' : 'bg-red-50 border-red-300' %>"><h3 class="font-bold text-lg">Quarter Review: <%= @review.status.titleize %></h3><p class="mt-1">Final PLI: <%= @review.final_percentage.present? ? format('%.2f%%', @review.final_percentage) : '-' %></p><p>Remarks: <%= @review.final_remarks.presence || '-' %></p></div><% end %>
  </div>
</div>
<style>.main-content{margin-left:240px}.archive-month-card{background:#fff;border-radius:1rem;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.07);transition:.2s}.archive-month-card:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,0,0,.11)}.archive-month-header{display:flex;align-items:center;gap:.5rem;padding:1rem 1.25rem;background:linear-gradient(135deg,#0f766e,#14b8a6);color:#fff;font-weight:700}.archive-remark{padding:1rem;border:1px solid #e2e8f0;border-left:4px solid #3b82f6;border-radius:.75rem;background:#f8fafc}.archive-remark strong{display:block;font-size:.7rem;color:#2563eb;margin-bottom:.4rem}@media(max-width:768px){.main-content{margin-left:0}}</style>
