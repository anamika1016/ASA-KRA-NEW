<% months = %w[april may june july august september october november december january february march] %>
<% back_path = if @observer_level.present?
                 observer_pli_index_path(@observer_level, financial_year: @selected_financial_year)
               else
                 l1_employee_details_path(financial_year: @selected_financial_year)
               end %>

<div class="main-content sidebar-hidden bg-gray-50 min-h-screen">
  <div class="kra-targets-page min-h-screen pl-64 pr-4 pt-4 pb-12 overflow-x-hidden bg-gradient-to-br from-gray-50 to-gray-100">
    <div class="bg-white border border-gray-200 rounded-xl shadow-lg overflow-hidden">
      <div class="bg-gray-100 px-6 py-4 border-b border-gray-200">
        <div class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h1 class="text-3xl font-bold text-gray-800 flex items-center">
            <i class="fas fa-users me-2 text-indigo-600"></i>
            Key result indicators - <%= @selected_financial_year %>
          </h1>

          <div class="flex flex-wrap items-center gap-3">
          <% if @financial_year_options.any? %>
            <%= form_with url: kra_targets_employee_detail_path(@employee_detail), method: :get, local: true, class: "flex items-center gap-3", data: { turbo: false } do %>
              <%= hidden_field_tag :observer_level, @observer_level if @observer_level.present? %>
              <%= hidden_field_tag :source, params[:source] %>
              <%= label_tag :financial_year, "Financial year", class: "text-sm font-semibold text-gray-700" %>
              <%= select_tag :financial_year, options_for_select(@financial_year_options, @selected_financial_year),
                  class: "bg-white border border-gray-300 rounded-lg px-4 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                  onchange: "this.form.submit()" %>
            <% end %>
          <% end %>
          <%= link_to export_kra_targets_employee_detail_path(@employee_detail, financial_year: @selected_financial_year, observer_level: @observer_level),
              class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-green-600 hover:bg-green-700 text-white font-semibold shadow-md transition duration-200" do %>
            <i class="fas fa-file-excel"></i>
            Export Excel
          <% end %>
          <%= link_to back_path, class: "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold border border-gray-300" do %>
            <i class="fas fa-arrow-left"></i> Back
          <% end %>
          </div>
        </div>

        <div class="target-meta-row">
          <span><strong>Department:</strong> <%= @employee_detail.department.presence || "N/A" %></span>
          <span><strong>Employee name:</strong> <%= @employee_detail.employee_name.presence || "N/A" %></span>
          <span><strong>L1 Name:</strong> <%= @employee_detail.l1_employer_name.presence || "N/A" %></span>
        </div>
        </div>
      </div>

      <div class="p-6">
      <div class="table-wrapper overflow-auto bg-white rounded-lg border border-gray-200 shadow-sm">
        <table class="table table-hover w-full min-w-full">
          <thead class="bg-gray-800">
            <tr>
              <th class="px-5 py-4 text-center text-xs font-medium text-white tracking-wider border-r border-gray-600">S.No</th>
              <th class="kri-column px-5 py-4 text-left text-xs font-medium text-white tracking-wider border-r border-gray-600">Key result indicators</th>
              <th class="px-5 py-4 text-left text-xs font-medium text-white tracking-wider border-r border-gray-600">Unit of measurement</th>
              <th class="px-5 py-4 text-left text-xs font-medium text-white tracking-wider border-r border-gray-600"><%= annual_target_fy_label(@selected_financial_year) %></th>
              <% months.each do |month| %>
                <th class="px-5 py-4 text-center text-xs font-medium text-white tracking-wider border-r border-gray-600 bg-gray-700"><%= month.first(3).upcase %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @kra_user_details.each_with_index do |detail, index| %>
              <tr class="<%= index.even? ? 'bg-gray-50' : 'bg-white' %> hover:bg-gray-100 transition-colors duration-200">
                <td class="px-5 py-4 text-sm text-gray-800 border-r border-gray-200 text-center"><%= index + 1 %></td>
                <% kri_name = activity_name_display(detail.activity) %>
                <td class="kri-column px-5 py-4 text-sm text-gray-800 border-r border-gray-200" title="<%= kri_name %>"><span class="kri-text"><%= kri_name %></span></td>
                <td class="px-5 py-4 text-sm text-gray-800 border-r border-gray-200 text-center"><%= detail.activity.unit.presence || "" %></td>
                <td class="px-5 py-4 text-sm text-gray-800 border-r border-gray-200 text-center"><%= annual_target_display(detail.activity) %></td>
                <% months.each do |month| %>
                  <% target_value = clean_spreadsheet_display_value(detail.public_send(month)) %>
                  <td class="px-5 py-4 text-sm text-center border-r border-gray-200">
                    <span class="<%= target_value.present? ? 'text-indigo-700 font-semibold bg-indigo-50 px-3 py-1 rounded-full' : 'text-gray-400' %>"><%= target_value.presence || "-" %></span>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      </div>

      <% if @kra_user_details.empty? %>
        <div class="py-16 text-center text-gray-500">
          <i class="fas fa-inbox text-4xl mb-3"></i>
          <p class="font-semibold">No KRA targets found for this financial year.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .kra-targets-page { padding-left: 16rem; }
  .sidebar-hidden .kra-targets-page { padding-right: 1rem; }
  body.sidebar-collapsed .kra-targets-page { padding-left: 1rem !important; }
  .target-meta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .target-meta-row span { padding: 0.5rem 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; background: #fff; color: #334155; font-size: 0.875rem; }
  .kri-column { min-width: 25rem; max-width: 25rem; }
  .kri-text { display: block; white-space: normal; overflow-wrap: anywhere; }

  @media (max-width: 1023px) {
    .kra-targets-page { padding-left: 1rem; }
  }
</style>
